{
  "manifest_version": 3,
  "name": "Mute Bridge",
  "version": "0.1.0",
  "key": "",
  "description": "Mirrors the Windows system mic mute (Win+Alt+K) into Google Meet and Zoom web.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://meet.google.com/*", "https://*.zoom.us/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
